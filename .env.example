# Local development: copy this file to .env and generate a random key.
APP_ENV=development
FLASK_SECRET_KEY=replace-with-a-long-random-value
SITE_URL=http://127.0.0.1:5000

# Block compliant crawlers until the public site is ready for search discovery.
ROBOTS_ALLOW_CRAWLING=false

# SMTP is required for the enquiry form to send. Keep credentials private.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_TO=iantaylor@gmail.com

# Local development uses process memory. Use a shared Redis URL in production.
RATELIMIT_STORAGE_URI=memory://

# Enable only when the app is reachable through a known trusted proxy.
PROXY_FIX_ENABLED=false
PROXY_FIX_X_FOR=1
